{
  "name": "svg-app-icon-expo-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "install-local",
    "prepare": "expo prebuild && npm run clean-icons && react-native-svg-app-icon",
    "clean-icons": "npx --yes rimraf --glob \"android/app/src/main/res/mipmap-*\" \"ios/**/AppIcon.appiconset\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "icon": "npx install-local && react-native-svg-app-icon"
  },
  "dependencies": {
    "expo": "^58.0.22",
    "expo-dev-client": "~58.0.18",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "private": true,
  "devDependencies": {
    "install-local": "^4.1.0"
  },
  "localDependencies": {
    "react-native-svg-app-icon": ".."
  }
}
