{
  "name": "react-native-svg-app-icon",
  "version": "0.7.0",
  "description": "App icon generator for React Native projects",
  "keywords": [
    "app-icon",
    "react-native",
    "svg"
  ],
  "homepage": "https://github.com/aeirola/react-native-svg-app-icon",
  "bugs": {
    "url": "https://github.com/aeirola/react-native-svg-app-icon/issues"
  },
  "license": "MIT",
  "author": "Axel Havukangas <axel@havukangas.fi>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeirola/react-native-svg-app-icon.git"
  },
  "bin": {
    "react-native-svg-app-icon": "dist/cli/index.js"
  },
  "files": [
    "assets/",
    "dist/"
  ],
  "type": "commonjs",
  "main": "dist/lib/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "prepare": "npm run clean && tsc --project tsconfig.build.json",
    "prepack": "node scripts/prepack-readme.js",
    "postpack": "node scripts/prepack-readme.js revert",
    "test": "concurrently 'npm:test:*'",
    "test:lint:format": "oxfmt --check",
    "test:lint:style": "oxlint",
    "test:lint:types": "tsc",
    "test:unit": "vitest run src/",
    "test:integration": "npm run prepare && vitest run test/integration/"
  },
  "dependencies": {
    "arktype": ">=2.0.0",
    "commander": ">=8.3.0",
    "fs-extra": ">=3.0.0",
    "sharp": ">=0.26.0",
    "svg2vectordrawable": "2.9.1",
    "svgo": "^2.8.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.8",
    "@types/svgo": "^2.6.4",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "pixelmatch": "^7.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=9"
    },
    "runtime": {
      "name": "node",
      "version": ">=20.12"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
